{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FacetValue": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value",
          "count"
        ],
        "title": "FacetValue",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestAccepted": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "description": "Spans queued for writing (always the whole batch).",
            "title": "Accepted",
            "type": "integer"
          }
        },
        "required": [
          "accepted"
        ],
        "title": "IngestAccepted",
        "type": "object"
      },
      "IngestStats": {
        "additionalProperties": false,
        "description": "Counters of the ingest pipeline since the API started.",
        "properties": {
          "accepted_total": {
            "title": "Accepted Total",
            "type": "integer"
          },
          "queue_capacity": {
            "title": "Queue Capacity",
            "type": "integer"
          },
          "queue_depth": {
            "description": "Spans accepted but not yet written.",
            "title": "Queue Depth",
            "type": "integer"
          },
          "rejected_total": {
            "description": "Spans refused with 429 because the queue was full.",
            "title": "Rejected Total",
            "type": "integer"
          },
          "write_errors_total": {
            "description": "Spans dropped after the writer gave up retrying.",
            "title": "Write Errors Total",
            "type": "integer"
          },
          "written_total": {
            "title": "Written Total",
            "type": "integer"
          }
        },
        "required": [
          "queue_depth",
          "queue_capacity",
          "accepted_total",
          "rejected_total",
          "written_total",
          "write_errors_total"
        ],
        "title": "IngestStats",
        "type": "object"
      },
      "Span": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Attributes",
            "type": "object"
          },
          "end_time": {
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/SpanEvent"
            },
            "maxItems": 100,
            "title": "Events",
            "type": "array"
          },
          "kind": {
            "enum": [
              "agent",
              "llm",
              "tool",
              "guardrail"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parent_span_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Span Id"
          },
          "source": {
            "enum": [
              "sdk",
              "gateway"
            ],
            "title": "Source",
            "type": "string"
          },
          "span_id": {
            "title": "Span Id",
            "type": "string"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "enum": [
              "ok",
              "error",
              "blocked"
            ],
            "title": "Status",
            "type": "string"
          },
          "status_message": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Message"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "span_id",
          "name",
          "kind",
          "source",
          "start_time",
          "end_time"
        ],
        "title": "Span",
        "type": "object"
      },
      "SpanBatch": {
        "additionalProperties": false,
        "description": "Body of ``POST /v1/spans``.",
        "properties": {
          "spans": {
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Spans",
            "type": "array"
          }
        },
        "required": [
          "spans"
        ],
        "title": "SpanBatch",
        "type": "object"
      },
      "SpanEvent": {
        "additionalProperties": false,
        "description": "A point-in-time occurrence on a span, such as a failover or a budget alert.",
        "properties": {
          "attributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Attributes",
            "type": "object"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "name",
          "time"
        ],
        "title": "SpanEvent",
        "type": "object"
      },
      "TraceDetail": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Server time of this response; pass it as `since` on the next live poll.",
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "spans": {
            "description": "Spans ordered by start_time: all of them, or with `since` only those stored after it.",
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "title": "Spans",
            "type": "array"
          },
          "trace": {
            "$ref": "#/components/schemas/TraceSummary"
          }
        },
        "required": [
          "trace",
          "spans",
          "as_of"
        ],
        "title": "TraceDetail",
        "type": "object"
      },
      "TraceFacets": {
        "additionalProperties": false,
        "description": "Value counts per filter. Each facet's counts apply every other filter but not its own,\nso ticking a value never hides its siblings. At most ``FACET_MAX_VALUES`` values per facet,\nby count descending, then value.",
        "properties": {
          "client": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Client",
            "type": "array"
          },
          "model": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Model",
            "type": "array"
          },
          "name": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Name",
            "type": "array"
          },
          "service": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Service",
            "type": "array"
          },
          "source": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Source",
            "type": "array"
          },
          "status": {
            "items": {
              "$ref": "#/components/schemas/FacetValue"
            },
            "title": "Status",
            "type": "array"
          }
        },
        "required": [
          "name",
          "status",
          "source",
          "client",
          "model",
          "service"
        ],
        "title": "TraceFacets",
        "type": "object"
      },
      "TraceList": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "description": "Server time of this response; pass it as `since` on the next live poll.",
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor for the next page; null when there are no more traces. Valid only with the same order and filters.",
            "title": "Next Cursor"
          },
          "traces": {
            "items": {
              "$ref": "#/components/schemas/TraceSummary"
            },
            "title": "Traces",
            "type": "array"
          }
        },
        "required": [
          "traces",
          "next_cursor",
          "as_of"
        ],
        "title": "TraceList",
        "type": "object"
      },
      "TraceSummary": {
        "additionalProperties": false,
        "description": "One row of the traces list. Aggregates are computed over the trace's spans.",
        "properties": {
          "client": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "number"
          },
          "input_preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run's first user message (root span's input, else the earliest llm span's); null when capture is off.",
            "title": "Input Preview"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "llm_calls": {
            "title": "Llm Calls",
            "type": "integer"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output_preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run's final answer (root span's output, else the latest llm span's).",
            "title": "Output Preview"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "service_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Name"
          },
          "source": {
            "enum": [
              "sdk",
              "gateway"
            ],
            "title": "Source",
            "type": "string"
          },
          "span_count": {
            "title": "Span Count",
            "type": "integer"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "blocked"
            ],
            "title": "Status",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "name",
          "source",
          "service_name",
          "client",
          "start_time",
          "duration_ms",
          "status",
          "span_count",
          "llm_calls",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "models",
          "input_preview",
          "output_preview"
        ],
        "title": "TraceSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LucentPad API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/ingest/stats": {
      "get": {
        "operationId": "ingest_stats_v1_ingest_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestStats"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ingest Stats",
        "tags": [
          "ingest"
        ]
      }
    },
    "/v1/spans": {
      "post": {
        "description": "Queue a batch for writing and return at once; spans are readable shortly after.",
        "operationId": "ingest_spans_v1_spans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpanBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body larger than the ingest limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ingest queue full; nothing from the batch was accepted. Retry after the `Retry-After` header (seconds).",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Ingest Spans",
        "tags": [
          "ingest"
        ]
      }
    },
    "/v1/traces": {
      "get": {
        "operationId": "list_traces_v1_traces_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` of the previous page.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "desc",
              "enum": [
                "desc",
                "asc"
              ],
              "title": "Order",
              "type": "string"
            }
          },
          {
            "description": "Live polling: only traces that gained spans after this time (the previous response's `as_of`). Includes a few seconds of overlap, so expect traces already seen and merge by `trace_id`. Not combinable with `cursor`.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Live polling: only traces that gained spans after this time (the previous response's `as_of`). Includes a few seconds of overlap, so expect traces already seen and merge by `trace_id`. Not combinable with `cursor`.",
              "title": "Since"
            }
          },
          {
            "description": "Traces starting at or after this time (inclusive).",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Traces starting at or after this time (inclusive).",
              "title": "From"
            }
          },
          {
            "description": "Traces starting before this time (exclusive).",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Traces starting before this time (exclusive).",
              "title": "To"
            }
          },
          {
            "description": "Trace name; repeat for OR.",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Trace name; repeat for OR.",
              "title": "Name"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "ok",
                      "error",
                      "blocked"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "sdk",
                      "gateway"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "client",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Client"
            }
          },
          {
            "description": "Matches traces that used any of these models.",
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Matches traces that used any of these models.",
              "title": "Model"
            }
          },
          {
            "description": "`service.name`.",
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`service.name`.",
              "title": "Service"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Filter not implemented yet."
          }
        },
        "summary": "List Traces",
        "tags": [
          "query"
        ]
      }
    },
    "/v1/traces/facets": {
      "get": {
        "operationId": "trace_facets_v1_traces_facets_get",
        "parameters": [
          {
            "description": "Traces starting at or after this time (inclusive).",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Traces starting at or after this time (inclusive).",
              "title": "From"
            }
          },
          {
            "description": "Traces starting before this time (exclusive).",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Traces starting before this time (exclusive).",
              "title": "To"
            }
          },
          {
            "description": "Trace name; repeat for OR.",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Trace name; repeat for OR.",
              "title": "Name"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "ok",
                      "error",
                      "blocked"
                    ],
                    "type": "string"
                  },
                  "type": "array"
